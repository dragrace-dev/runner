# Copy this file to .env and edit it, or export these in your shell instead —
# docker compose reads .env automatically from this directory. Used by both
# docker-compose.yml (DooD) and docker-compose.dind.yml (DinD).

# Required. Must be unique across every runner you connect — two runners
# sharing an ID will fight over the same job subject.
RUNNER_ID=my-runner-01

# Optional — defaults point at the hosted DragRace platform. Override both to
# target your own backend.
#WS_BACKEND_URL=wss://ws.dragrace.dev
#BACKEND_URL=https://dragrace.dev

# Optional — GPU exposure ceiling for job containers: none (default), all, or
# an explicit index list like "0,1". docker-compose.dind.yml ignores anything
# but "none" — the DinD variant has no GPU support, see the README.
#RUNNER_GPUS=none

# Optional — public half of the update-signing key, only needed if you plan
# to run `runner update` inside the container. Leave unset otherwise.
#RUNNER_UPDATE_PUBLIC_KEY=

# Optional, docker-compose.yml (DooD) only — where job checkouts are bind
# mounted from the host into the sandbox. Must be a path Docker Desktop
# shares with its VM on macOS/Windows; see the comment in docker-compose.yml.
#RUNNER_JOB_DIR=/var/lib/dragrace/jobs
